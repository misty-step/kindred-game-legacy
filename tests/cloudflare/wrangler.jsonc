    "PARLOR_GUEST_TOKEN_KEYS": "{\"loopback\":\"S0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0s\"}",
    "PRODUCT_ENVIRONMENT": "test",
    "JEV_DECISIONS_URL": "http://127.0.0.1:43863/decisions",
